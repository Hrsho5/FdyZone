    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc",
    "prefullstack": "npm run build",
    "watch": "tsc -w",
    "dev": "nodemon dist/index.js",
    "server": "concurrently \"npm run watch\" \"npm run dev\"",
    "fullstack": "concurrently -k -n backend,frontend \"npm run server\" \"npm --prefix ../app run dev\"",
    "start": "node dist/index.js"
  },
